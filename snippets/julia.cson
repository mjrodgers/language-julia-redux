# Julia snippets. Type the prefix, then press Tab; Tab again moves between the
# fields, ending at $0. Bodies are indented with tabs, which Pulsar turns into
# the editor's indentation (four spaces for Julia).

'.source.julia':

  # DEFINITIONS

  'function':
    prefix: 'function'
    body: '''
      function ${1:name}(${2:args})
      \t$0
      end
    '''
  'function with docstring':
    prefix: 'functiond'
    body: '''
      """
          ${1:name}(${2:args})

      ${3:Description.}
      """
      function ${1:name}(${2:args})
      \t$0
      end
    '''
  'macro':
    prefix: 'macro'
    body: '''
      macro ${1:name}(${2:args})
      \t$0
      end
    '''
  'struct':
    prefix: 'struct'
    body: '''
      struct ${1:Name}${2: <: ${3:Supertype}}
      \t$0
      end
    '''
  'mutable struct':
    prefix: 'mutable'
    body: '''
      mutable struct ${1:Name}${2: <: ${3:Supertype}}
      \t$0
      end
    '''
  'struct with keyword constructor (@kwdef)':
    prefix: 'kwdef'
    body: '''
      Base.@kwdef struct ${1:Name}
      \t${2:field}::${3:Type} = ${4:default}
      end
    '''
  'abstract type':
    prefix: 'abstract'
    body: 'abstract type ${1:Name}${2: <: ${3:Supertype}} end'
  'primitive type':
    prefix: 'primitive'
    body: 'primitive type ${1:Name}${2: <: ${3:Supertype}} ${4:bits} end'
  'show method':
    prefix: 'show'
    body: '''
      function Base.show(io::IO, ${1:x}::${2:Type})
      \tprint(io, $0)
      end
    '''
  'main function (julia script.jl runs it)':
    prefix: 'main'
    body: '''
      function (@main)(args)
      \t$0
      \treturn 0
      end
    '''

  # MODULES

  'module':
    prefix: 'module'
    body: '''
      module ${1:Name}

      $0

      end # module ${1:Name}
    '''
  'using':
    prefix: 'using'
    body: 'using ${1:Package}'
  'using names from a package':
    prefix: 'usingf'
    body: 'using ${1:Package}: ${2:names}'
  'import':
    prefix: 'import'
    body: 'import ${1:Package}'
  'include':
    prefix: 'include'
    body: 'include("${1:file.jl}")'

  # CONTROL FLOW

  'if':
    prefix: 'if'
    body: '''
      if ${1:condition}
      \t$0
      end
    '''
  'if/else':
    prefix: 'ife'
    body: '''
      if ${1:condition}
      \t${2:# true}
      else
      \t${3:# false}
      end
    '''
  'if/elseif/else':
    prefix: 'ifelseif'
    body: '''
      if ${1:condition}
      \t${2:# first}
      elseif ${3:condition}
      \t${4:# second}
      else
      \t${5:# otherwise}
      end
    '''
  'elseif':
    prefix: 'elseif'
    body: '''
      elseif ${1:condition}
      \t$0
    '''
  'for':
    prefix: 'for'
    body: '''
      for ${1:i} in ${2:iter}
      \t$0
      end
    '''
  'while':
    prefix: 'while'
    body: '''
      while ${1:condition}
      \t$0
      end
    '''
  'try/catch':
    prefix: 'try'
    body: '''
      try
      \t${1:# code}
      catch ${2:err}
      \t$0
      end
    '''
  'try/finally':
    prefix: 'tryf'
    body: '''
      try
      \t${1:# code}
      finally
      \t$0
      end
    '''
  'try/catch/finally':
    prefix: 'trycf'
    body: '''
      try
      \t${1:# code}
      catch ${2:err}
      \t${3:# handle}
      finally
      \t$0
      end
    '''

  # BLOCKS

  'begin':
    prefix: 'begin'
    body: '''
      begin
      \t$0
      end
    '''
  'let':
    prefix: 'let'
    body: '''
      let ${1:x = 1}
      \t$0
      end
    '''
  'do':
    prefix: 'do'
    body: '''
      do ${1:x}
      \t$0
      end
    '''
  'quote':
    prefix: 'quote'
    body: '''
      quote
      \t$0
      end
    '''

  # TESTS

  '@testset':
    prefix: 'testset'
    body: '''
      @testset "${1:name}" begin
      \t$0
      end
    '''
  '@test':
    prefix: 'test'
    body: '@test ${1:expr}'
  '@test_throws':
    prefix: 'test_throws'
    body: '@test_throws ${1:ErrorException} ${2:expr}'

  # OTHER

  'shebang':
    prefix: '#!'
    body: '''
      #!/usr/bin/env julia
      $0
    '''
  'block comment':
    prefix: '#='
    body: '''
      #=
      $0
      =#
    '''


# Inside docstrings: their sections, as Documenter.jl writes them.
'.source.julia .docstring':

  'Examples section':
    prefix: 'examples'
    body: '''
      # Examples
      ```jldoctest
      julia> ${1:expr}
      ${2:result}
      ```
    '''
  'jldoctest block':
    prefix: 'jldoctest'
    body: '''
      ```jldoctest
      julia> ${1:expr}
      ${2:result}
      ```
    '''
  'Arguments section':
    prefix: 'arguments'
    body: '''
      # Arguments
      - `${1:name}`: ${2:description}
    '''
  'admonition':
    prefix: '!!!'
    body: '''
      !!! ${1:note}
          $0
    '''
