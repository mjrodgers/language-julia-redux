# Indentation and folding come from the Tree-sitter queries in
# grammars/tree-sitter-julia, so the TextMate-era `increaseIndentPattern`,
# `decreaseIndentPattern` and `foldEndPattern` settings are not needed.
'.source.julia':
  'editor':
    'tabLength': 4
    'softTabs': true
    'commentStart': '# '
    'commentDelimiters':
      'line': '#'
      'block': ['#=', '=#']
